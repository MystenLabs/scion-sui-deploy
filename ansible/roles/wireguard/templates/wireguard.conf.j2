[Interface]
Address = {% for addr in wireguard.interface.addresses %}{{ addr }}{% if not loop.last %}, {% endif %}{% endfor %}

PrivateKey = {{ wireguard_private_key_content }}
ListenPort = {{ wireguard.interface.listen_port | default(51820) }}
PostUp = iptables -t nat -A POSTROUTING -o wg0 -j SNAT --to-source {{  public_ipv4 }}
PostDown = iptables -t nat -D POSTROUTING -o wg0 -j SNAT --to-source {{  public_ipv4 }}
Table = off

{% if wireguard.interface.peer %}
[Peer]
PublicKey = {{ wireguard.interface.peer.public_key }}
AllowedIPs = {{ allowed_ips | join(',') }}
Endpoint = {{ wireguard.interface.peer.endpoint }}
PersistentKeepalive = {{ wireguard.interface.peer.persistent_keepalive | default(25) }}
{% endif %}
